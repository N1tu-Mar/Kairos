# Base URL of the Kairos FastAPI backend.
# Server-only on purpose. Do NOT rename this to NEXT_PUBLIC_* — the browser
# must not hold the backend address or call it directly.
KAIROS_API_URL=http://127.0.0.1:8000

# Which founder this dashboard reads. The backend seeds `founder_demo` from
# data/demo_founder.json on startup.
KAIROS_FOUNDER_ID=founder_demo

# Timeout (ms) for calls to the backend. Every call this app makes is short:
# starting a run creates a job and returns immediately, and the dashboard
# polls for the result. The run's own ceiling is the backend's
# KAIROS_RUN_TIMEOUT_S, not a socket held open here.
KAIROS_API_TIMEOUT_MS=10000

# Bearer token for the backend, when the backend sets KAIROS_API_TOKEN.
# Server-only: it is attached inside src/lib/api.ts and never reaches the
# browser. Leave empty when the backend runs open on localhost.
KAIROS_API_TOKEN=
