# Kairos — environment. Copy to `.env`. NEVER commit `.env`.
#
# ─────────────────────────────────────────────────────────────────────────────
# Bedrock model IDs are region-specific and versioned. Do NOT paste values
# from memory or from a blog post. Discover them, then paste what comes back:
#
#   aws bedrock list-foundation-models --region us-east-1 \
#     --query 'modelSummaries[?contains(modelId, `anthropic`)].modelId' --output table
#
# Some Anthropic models on Bedrock are only reachable through an inference
# profile (IDs prefixed `us.` / `global.`), not the bare foundation-model ID.
# If an invoke returns ValidationException about on-demand throughput, list
# profiles instead:
#
#   aws bedrock list-inference-profiles --region us-east-1
#
# agent/config.py raises on startup if these are empty. That is deliberate —
# a wrong-but-plausible model ID costs more debugging time than a loud failure.
# ─────────────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1

# ── Environment ──────────────────────────────────────────────────────────────
# `local` (default) is the single-founder demo posture: the API may run open,
# prices may be zero, and anonymous identity is accepted.
#
# `production` stops all three from being advisory. GET /ready then fails
# (503) without KAIROS_API_TOKEN and without live prices, and the auth layer
# refuses anonymous identity outright. Set it on any deployment that is not
# your laptop.
KAIROS_ENV=local

# Reasoning tier — Assessor, Drafter. Claude Sonnet class.
BEDROCK_MODEL_REASONING=

# Classification tier — eligibility parsing, Auditor. Claude Haiku class.
BEDROCK_MODEL_CLASSIFY=

# ── Cost + rate caps (Section 9, rule 12). Code, not discipline. ──────────────
# Hard ceiling on cumulative tokens for a single scheduled run.
KAIROS_MAX_RUN_TOKENS=250000
# Most opportunities the Assessor is allowed to judge in one run.
KAIROS_MAX_ASSESSMENTS=25
# Global daily spend cap in USD. Run halts and reports when crossed.
KAIROS_DAILY_USD_CAP=3.00

# Price per 1M tokens, USD. Confirm against the live Bedrock pricing page for
# your region before trusting the cost estimate. There is deliberately no
# default table of "roughly what it costs" in this repository — a stale guess
# would under-count spend against a real cap.
#
# Left at 0, every call costs $0.00, so KAIROS_DAILY_USD_CAP can never trip
# and only KAIROS_MAX_RUN_TOKENS is doing work. In production mode /ready
# reports that as `spend_cap: unenforceable`.
KAIROS_PRICE_REASONING_IN_PER_MTOK=0
KAIROS_PRICE_REASONING_OUT_PER_MTOK=0
KAIROS_PRICE_CLASSIFY_IN_PER_MTOK=0
KAIROS_PRICE_CLASSIFY_OUT_PER_MTOK=0

# ── Sources ──────────────────────────────────────────────────────────────────
# Tier 2. No authentication required.
GRANTS_GOV_BASE_URL=https://api.grants.gov/v1/api
KAIROS_HTTP_TIMEOUT_S=15
# Tier 3 — AgentCore Browser. Off until stable for 48h (Section 5).
KAIROS_ENABLE_BROWSER=false
# Include unverified seed rows in runs. Keep false — see data/README.md.
KAIROS_ALLOW_UNVERIFIED_SEED=false

# ── API authentication ────────────────────────────────────────────────────────────
# Bearer token required on every endpoint except /health and /ready. Empty
# runs the API open — acceptable on localhost only, the API logs it at
# startup, and /ready fails in production mode.
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# The frontend must carry the same value in its own KAIROS_API_TOKEN.
KAIROS_API_TOKEN=

# Multi-founder authorization. A shared token is not an identity: it proves
# somebody holds the secret, never *which* founder they are, so it grants the
# single seeded founder and nothing else.
#
# Point this at a JSON credential file and each token maps to its own subject
# and its own set of founder ids. Tokens are stored as SHA-256 hashes, so a
# leaked file hands over no working credentials. Rotation and revocation take
# effect on the next request — the file is re-read when its mtime changes, no
# restart, no deploy. When set, this supersedes KAIROS_API_TOKEN.
#
# Never commit this file. Mount it from a secret store. See api/auth.py for
# the format and for the Authenticator seam a real identity provider (OIDC,
# JWT) plugs into — that is a product decision and is deliberately not faked.
KAIROS_CREDENTIALS_FILE=

# ── Storage ──────────────────────────────────────────────────────────────────
KAIROS_DB_URL=sqlite:///./kairos.db
# Holds the SQLite spend ledger, the run leases, and the scheduler failure
# log. Must be writable and must survive a restart.
KAIROS_STATE_DIR=./.kairos

# ── Run execution ────────────────────────────────────────────────────────────
# Wall-clock ceiling on one pipeline run. The job executor cancels a run that
# outlives it and records a `timeout` failure. The run lease TTL is twice this,
# so a live run's lease can never expire underneath it.
KAIROS_RUN_TIMEOUT_S=1800

# ── Observability (Strands OpenTelemetry -> CloudWatch) ──────────────────────
KAIROS_ENABLE_OTEL=false
OTEL_EXPORTER_OTLP_ENDPOINT=
